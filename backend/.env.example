DATABASE_URL="file:./dev.db"
ENVIRONMENT="development"
# Comma-separated frontend origins allowed to call this API with credentials.
CORS_ORIGINS="http://localhost:5173"
# Needed for the Marketing Strategist Agent (POST .../strategy). Get one at
# https://console.anthropic.com/ — leave unset and that endpoint 500s with a
# clear message; nothing else in the app depends on it.
ANTHROPIC_API_KEY=""

# Where the SPA runs — only used to build the browser redirect at the end of
# the Meta OAuth callback (see FRONTEND_URL in app/core/config.py).
FRONTEND_URL="http://localhost:5173"

# Where this API itself runs — used to build the public, absolute URL for a
# stored ProductImage so Meta's servers can fetch it directly (see
# BACKEND_URL in app/core/config.py). Meta genuinely cannot reach
# http://localhost:8000, so image-backed ad creatives only work once deployed.
BACKEND_URL="http://localhost:8000"

# Needed for the Meta Ads connection (GET .../meta/connect). Create an app at
# https://developers.facebook.com/apps/ with the Facebook Login and Marketing
# API products added, then register META_REDIRECT_URI below as a valid OAuth
# redirect URI in that app's settings. Leave unset and the connect endpoint
# 500s with a clear message; nothing else in the app depends on these.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:8000/meta/callback"

# Encrypts MetaConnection.accessToken at rest (app/core/crypto.py) — a real
# Meta access token has to be usable again for live Marketing API calls, so
# it's encrypted, not hashed. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset and connecting/reading a Meta connection 500s with a clear
# message.
META_TOKEN_ENCRYPTION_KEY=""

# Needed to send the forgot-password reset email (app/services/email.py).
# Get a key at https://resend.com/api-keys. Leave unset and requesting a
# reset 500s with a clear message. EMAIL_FROM defaults to Resend's own
# sandbox sender (onboarding@resend.dev), which needs no domain verification
# — swap in a verified custom-domain address once one exists.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Scaffold, not wired into publish yet: turns on POST
# .../products/{id}/check-url (app/services/url_reachability.py). Off by
# default.
URL_REACHABILITY_CHECK_ENABLED="false"

# Test-only: swaps every real Meta Graph API call for a canned fake response
# and exposes POST .../meta/fake-connect, so e2e tests can get past Meta
# connection without a real Meta login (see fake_meta_enabled in
# app/core/config.py). Set by frontend/playwright.config.ts's e2e backend
# process — never set this in a real deployment; the app refuses to boot
# at all if it's true while ENVIRONMENT=production.
FAKE_META="false"

# Test-only, same shape as FAKE_META but for the Strategist/Creative
# Agents' Anthropic calls (see fake_llm_enabled in app/core/config.py) —
# canned, schema-valid output instead of a real call. Set by
# frontend/playwright.config.ts's e2e backend process — never set this in
# a real deployment; the app refuses to boot at all if it's true while
# ENVIRONMENT=production.
FAKE_LLM="false"
