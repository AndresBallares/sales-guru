DATABASE_URL="file:./dev.db"
ENVIRONMENT="development"
# Comma-separated frontend origins allowed to call this API with credentials.
CORS_ORIGINS="http://localhost:5173"
# Needed for the Marketing Strategist Agent (POST .../strategy). Get one at
# https://console.anthropic.com/ — leave unset and that endpoint 500s with a
# clear message; nothing else in the app depends on it.
ANTHROPIC_API_KEY=""

# Where the SPA runs — only used to build the browser redirect at the end of
# the Meta OAuth callback (see FRONTEND_URL in app/core/config.py).
FRONTEND_URL="http://localhost:5173"

# Needed for the Meta Ads connection (GET .../meta/connect). Create an app at
# https://developers.facebook.com/apps/ with the Facebook Login and Marketing
# API products added, then register META_REDIRECT_URI below as a valid OAuth
# redirect URI in that app's settings. Leave unset and the connect endpoint
# 500s with a clear message; nothing else in the app depends on these.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:8000/meta/callback"
