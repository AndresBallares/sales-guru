# Environment for the test suite (tests/conftest.py) and any smoke/
# throwaway script — loaded explicitly via dotenv_path, never the default
# .env. Never point DATABASE_URL here at anything but a test.db-style
# file; see CLAUDE.md's destructive-command rule and
# backend/scripts/db-reset.sh, which refuses to run against anything else.

DATABASE_URL="file:./test.db"
ENVIRONMENT="development"

# The test suite runs entirely in fake mode — no real ANTHROPIC_API_KEY or
# Meta OAuth needed (see fake_llm_enabled/fake_meta_enabled,
# app/core/config.py). FAKE_META is set per-test via monkeypatch instead
# (tests/test_publish.py and friends mock the individual meta.* calls
# directly), so only FAKE_LLM is set here.
FAKE_LLM="1"

# The APScheduler jobs (metrics collection + optimization evaluation, PRD.md
# build step 10) must never fire during the test suite — they'd run against
# a database individual tests are actively resetting mid-run.
ENABLE_SCHEDULER="false"
