// Sales Guru database schema.
//
// Hierarchy: User -> Organization -> Business -> {Product, Audience, Campaign}
// Campaign -> AdSet -> Ad -> Creative mirrors the Meta Marketing API's own
// object hierarchy (Campaign / AdSet / Ad / AdCreative), since MVP build
// step 8 publishes directly into that structure (PRD.md §5).
//
// Scope: MVP core loop only (PRD.md §2, §5). Subscription is a thin stub —
// no billing logic reads/writes it until the post-MVP billing step.
//
// SQLite has no native enum support, so status/objective fields below are
// plain strings, validated as enums at the application layer (app/schemas)
// so behavior stays identical once swapped to Postgres.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  hashedPassword String
  organizations  Organization[]
  sessions       Session[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// tokenHash, not the raw session token, is stored — same defense-in-depth
// principle as hashedPassword: a DB read alone shouldn't be enough to
// impersonate a session.
model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Organization {
  id           String        @id @default(cuid())
  owner        User          @relation(fields: [ownerId], references: [id])
  ownerId      String
  name         String
  businesses   Business[]
  subscription Subscription?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Subscription: DRAFT | ACTIVE | PAST_DUE | CANCELED (unused until the
// post-MVP billing step — see PRD.md §4, §5).
model Subscription {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @unique
  plan           String?
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Business onboarding fields (PRD.md §7): name required, the rest optional
// to keep signup friction low — AI strategy generation degrades gracefully
// with less context rather than blocking onboarding on them.
model Business {
  id             String          @id @default(cuid())
  organization   Organization    @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  website        String?
  industry       String?
  location       String?
  description    String?
  products       Product[]
  audiences      Audience[]
  metaConnection MetaConnection?
  campaigns      Campaign[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Product has no separate name field — `description` ("What do you sell?")
// doubles as its identity, truncated for display in lists (PRD.md §7).
model Product {
  id          String         @id @default(cuid())
  business    Business       @relation(fields: [businessId], references: [id])
  businessId  String
  description String
  price       Float?
  margin      Float?
  features    String?
  benefits    String?
  url         String?
  images      ProductImage[]
  campaigns   Campaign[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  url       String
  createdAt DateTime @default(now())
}

// Same no-separate-name convention as Product — `description` ("Who buys?")
// is the identity. ageMin/ageMax are separate ints (not a freeform range
// string) to match Meta's age_min/age_max targeting fields directly.
// location/interests stay freeform text — Meta resolves those to its own
// location/interest taxonomy IDs at publish time (PRD.md §7), not here.
model Audience {
  id          String     @id @default(cuid())
  business    Business   @relation(fields: [businessId], references: [id])
  businessId  String
  description String
  ageMin      Int?
  ageMax      Int?
  location    String?
  interests   String?
  problem     String?
  desire      String?
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// adAccountId/pageId start null — a row is created once the OAuth code
// exchange succeeds (so accessToken/tokenExpiresAt/metaUserId are always
// set), but the user still has to pick which ad account and Page to use
// (one Meta identity can have several of each), via a separate finalize
// step (PRD.md build step 6, app/api/meta.py). Same "exists before it's
// complete" shape already used for Strategy before objective was known to
// be fixed, and for Creative before one variant is SELECTED.
//
// accessToken is stored in plaintext, not hashed — unlike Session/User,
// this token has to be usable later for real Marketing API calls, not just
// verified. Known gap, not addressed yet (PRD.md §4): revisit encryption
// at rest before production, same bucket as the samesite=lax cookie gap.
model MetaConnection {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id])
  businessId     String   @unique
  metaUserId     String
  accessToken    String
  adAccountId    String?
  pageId         String?
  tokenExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Short-lived, one-time-use CSRF state for the Meta OAuth redirect
// round-trip — id itself (an unguessable cuid) is passed as the OAuth
// `state` param. Looked up and deleted at the callback (app/api/meta.py),
// with a TTL check (see _STATE_TTL) so an old, unused row can't be replayed.
// A dedicated table rather than a signed token because the callback also
// needs to recover which business the flow was started for.
model MetaOAuthState {
  id         String   @id @default(cuid())
  businessId String
  createdAt  DateTime @default(now())
}

// Campaign.objective: SALES | LEADS | TRAFFIC | MESSAGES | AWARENESS
//                     (PRD.md §7 — maps to Meta's own campaign objectives
//                     at publish time)
// Campaign.status: DRAFT | STRATEGY_GENERATED | ADS_GENERATED |
//                  PENDING_APPROVAL | APPROVED | LIVE | PAUSED | FAILED
// Campaign.name is a human-readable label (e.g. "Custom Colombian Emerald
// Ring") — without it, campaigns are only distinguishable by
// objective+product+audience, and two campaigns with the same objective
// would look identical in any list.
model Campaign {
  id                      String                       @id @default(cuid())
  business                Business                     @relation(fields: [businessId], references: [id])
  businessId              String
  product                 Product?                     @relation(fields: [productId], references: [id])
  productId               String?
  audience                Audience?                    @relation(fields: [audienceId], references: [id])
  audienceId              String?
  name                    String?
  objective               String
  status                  String                       @default("DRAFT")
  strategy                Strategy?
  adSets                  AdSet[]
  creatives               Creative[]
  metrics                 Metric[]
  optimizations           OptimizationRecommendation[]
  metaCampaignId          String?
  // Last time the scheduled optimization job evaluated this campaign at
  // all (app/services/optimizer.py's evaluate_all_live_campaigns) —
  // updated on every evaluation regardless of outcome (WAIT or an actual
  // recommendation), so the data-sufficiency gate's "time elapsed" leg
  // has something to measure even on runs that produce nothing.
  lastOptimizationCheckAt DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
}

// content holds the full structured Marketing Strategist Agent output
// (objective/targetAudience/offer/positioning/creativeAngles/copyStrategy/
// budgetRecommendation) as a JSON-serialized string — SQLite has no native
// Json type (confirmed earlier in this build), so this follows the same
// "serialize at the app layer" pattern already used elsewhere in this
// schema, validated/typed via a Pydantic model on the way in and out.
model Strategy {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @unique
  content    String
  createdAt  DateTime @default(now())
}

// AdSet.status: DRAFT | READY | LIVE | PAUSED
model AdSet {
  id               String   @id @default(cuid())
  campaign         Campaign @relation(fields: [campaignId], references: [id])
  campaignId       String
  name             String
  budget           Float
  optimizationGoal String
  status           String   @default("DRAFT")
  ads              Ad[]
  metaAdSetId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Ad.status: DRAFT | READY | LIVE | PAUSED
model Ad {
  id        String     @id @default(cuid())
  adSet     AdSet      @relation(fields: [adSetId], references: [id])
  adSetId   String
  name      String
  status    String     @default("DRAFT")
  creatives Creative[]
  metaAdId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Creative.status: GENERATED | SELECTED | REJECTED — one Creative per
// campaign moves to SELECTED (the rest REJECTED) when the user picks a
// variant (PRD.md build step 6/7); no per-creative APPROVED state, that
// term is reserved for the campaign-level approval gate (step 7).
// Creative.cta: a curated MVP subset of Meta's real call-to-action button
// enum (Meta has 40+ values; not replicating all of them until publish,
// step 8, actually needs to) — SHOP_NOW | LEARN_MORE | SIGN_UP | SUBSCRIBE |
// CONTACT_US | MESSAGE_PAGE | GET_OFFER | DOWNLOAD | BOOK_NOW
//
// bodyText is Meta's "Primary Text" (main copy above the image/video);
// description is Meta's separate, distinct secondary line — these are two
// different fields on Meta's own ad creative, not one.
//
// campaignId is the generation-time link — the Creative Agent runs off a
// Campaign's Strategy (build step 6), before any AdSet/Ad exists (those
// are pure publish-time constructs, step 8, needing real budget/Meta IDs
// that don't exist yet here). adId stays nullable until the selected
// Creative is actually attached to a real Ad at publish time.
//
// creativeAngle records which of the parent Strategy's creativeAngles this
// variant was built around, for traceability in the approval UI.
// imagePrompt/videoPrompt are the generation recipes, kept distinct from
// imageUrl (the resulting asset) so a variant can be regenerated/tweaked
// from its prompt.
model Creative {
  id             String   @id @default(cuid())
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  campaignId     String
  ad             Ad?      @relation(fields: [adId], references: [id])
  adId           String?
  headline       String
  bodyText       String
  description    String
  cta            String
  creativeAngle  String?
  imagePrompt    String?
  videoPrompt    String?
  imageUrl       String?
  status         String   @default("GENERATED")
  metaCreativeId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Metric {
  id          String   @id @default(cuid())
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  campaignId  String
  impressions Int
  clicks      Int
  spend       Float
  conversions Int
  fetchedAt   DateTime @default(now())
}

// OptimizationRecommendation.actionType: PAUSE_AD | INCREASE_BUDGET |
//                                        DECREASE_BUDGET
// OptimizationRecommendation.status: PENDING | APPLIED | REJECTED | SUPERSEDED
// — no separate APPROVED state: approving IS applying, one explicit click
// (PRD.md build step 10's checkpoint), same "approve = act" shape as
// Campaign's own PENDING_APPROVAL -> APPROVED -> LIVE, just collapsed to
// one step here since there's nothing further to gate after approval.
// Generating a new recommendation moves any still-PENDING one for the
// same campaign to SUPERSEDED rather than deleting it, so the decision
// history (including recommendations nobody acted on) stays queryable —
// unlike Strategy/Creative, past recommendations are meaningful history,
// not stale drafts.
//
// targetAdId records which local Ad a PAUSE_AD recommendation targets
// (the campaign's only Ad today, since publish creates exactly one — see
// app/services/publish.py — but the field models Meta's real shape:
// per-ad pausing, not per-campaign). currentBudget/suggestedBudget are
// only meaningful for INCREASE_BUDGET/DECREASE_BUDGET; suggestedBudget is
// already guardrail-capped (see app/services/optimizer.py) by the time
// it's stored, not the LLM's raw, unbounded suggestion.
//
// OptimizationRecommendation.risk: LOW | MEDIUM | HIGH — the LLM's own
// self-assessment, part of its forced tool call (confidence too).
// requiresApproval is deliberately NOT taken from the LLM — it's computed
// by app/services/optimizer.py's compute_requires_approval from
// risk/confidence/guardrails, so a future auto-apply capability is a rule
// change there, not a schema or LLM-trust change. Always true today
// (PRD.md build step 10's checkpoint requirement — every recommendation
// requires a human click, regardless of computed risk, until auto-apply
// for LOW risk is explicitly built).
model OptimizationRecommendation {
  id               String   @id @default(cuid())
  campaign         Campaign @relation(fields: [campaignId], references: [id])
  campaignId       String
  actionType       String
  targetAdId       String?
  currentBudget    Float?
  suggestedBudget  Float?
  reasoning        String
  confidence       Float
  risk             String
  requiresApproval Boolean  @default(true)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
