// Sales Guru database schema — PRODUCTION (Postgres) copy.
//
// This mirrors ../schema.prisma (the SQLite schema used for local dev)
// model-for-model — only the datasource provider differs. A single
// schema.prisma can't target both providers at once (the migration SQL
// itself is dialect-specific: SQLite's AUTOINCREMENT/PRAGMA statements
// don't run on Postgres), so render.yaml's build points `prisma generate`/
// `migrate deploy` at this file via `--schema=prisma/postgres/schema.prisma`
// instead. Keep the two model definitions in sync by hand when either
// changes — see README.md's Database schema changes section.
//
// Hierarchy: User -> Organization -> Business -> {Product, Audience, Campaign}
// Campaign -> AdSet -> Ad -> Creative mirrors the Meta Marketing API's own
// object hierarchy (Campaign / AdSet / Ad / AdCreative), since MVP build
// step 8 publishes directly into that structure (PRD.md §5).
//
// Scope: MVP core loop only (PRD.md §2, §5). Subscription is a thin stub —
// no billing logic reads/writes it until the post-MVP billing step.
//
// Status/objective fields below are plain strings rather than native
// enums, validated as enums at the application layer (app/schemas) —
// kept as strings here too (rather than switching to Postgres native
// enums) so the two schemas stay identical apart from the datasource.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  hashedPassword      String
  organizations       Organization[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  // Null means "hasn't accepted the current terms" — either a brand-new
  // account that somehow bypassed the signup gate, or (the actual expected
  // case) an existing account that predates this field entirely. Never
  // reset to null by a terms version bump — TERMS_VERSION (app/core/
  // terms.py) changing is what signals re-acceptance is needed, compared
  // against termsVersion, not this timestamp.
  termsAcceptedAt     DateTime?
  termsVersion        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

// tokenHash, not the raw session token, is stored — same defense-in-depth
// principle as hashedPassword: a DB read alone shouldn't be enough to
// impersonate a session.
model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// tokenHash, not the raw reset token, is stored — same defense-in-depth
// principle as Session.tokenHash. usedAt (nullable) marks a token
// consumed — either because it was actually used to reset the password,
// or because a newer request superseded it (only the latest link a user
// requested should ever work) — rows are never deleted, so
// PasswordResetToken.createdAt can still answer "how many times has this
// user requested a reset in the last hour" for rate-limiting even after
// older tokens are superseded.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Organization {
  id           String        @id @default(cuid())
  owner        User          @relation(fields: [ownerId], references: [id])
  ownerId      String
  name         String
  businesses   Business[]
  subscription Subscription?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Subscription: DRAFT | ACTIVE | PAST_DUE | CANCELED (unused until the
// post-MVP billing step — see PRD.md §4, §5).
model Subscription {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @unique
  plan           String?
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Business onboarding fields (PRD.md §7): name required, the rest optional
// to keep signup friction low — AI strategy generation degrades gracefully
// with less context rather than blocking onboarding on them.
model Business {
  id                            String          @id @default(cuid())
  organization                  Organization    @relation(fields: [organizationId], references: [id])
  organizationId                String
  name                          String
  website                       String?
  industry                      String?
  location                      String?
  description                   String?
  // Self-reported once, the first time a strategy is generated for this
  // business (app/api/strategy.py) — null until then. Only consulted when
  // the real-data check (Meta account-level ad history, once connected)
  // comes back empty; real data always takes priority over this when both
  // are available. Feeds the Marketing Strategist Agent's TEST_PLAN vs.
  // STRATEGY_OPTIMIZATION decision (see app/services/strategist.py).
  hasPriorAdvertisingExperience Boolean?
  // The business's logo, stored the same way as ProductImage (Option A,
  // confirmed 2026-09-02) — a single replaceable pair of columns rather
  // than a separate one-row-per-business model, since unlike product
  // photos there's never more than one. Uploaded once at business
  // creation (app/api/business.py's upload_business_logo); both null
  // until then. Feeds brand-consistent ad generation (the Creative
  // Agent can ground image generation in it) — that consumption is a
  // separate, not-yet-built pass; for now this just stores and serves it.
  logoData                      Bytes?
  logoContentType               String?
  brandProfile                  BrandProfile?
  products                      Product[]
  audiences                     Audience[]
  metaConnection                MetaConnection?
  campaigns                     Campaign[]
  // Soft delete (DELETE /businesses/{id}, app/api/business.py) — set
  // instead of removing the row, so child records (products, photos,
  // brand profile, campaigns, Meta connection) are preserved untouched
  // rather than cascade-deleted. Null for an active business. Every
  // business-scoped lookup must filter this out and 404 otherwise — the
  // single choke point is get_owned_business (app/core/authz.py); the few
  // routes not behind it (business-logo/product-image serve routes, the
  // Meta OAuth callback, the scheduled optimization jobs) each check it
  // directly.
  deletedAt                     DateTime?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
}

// "Brand DNA" (PRD.md §5 step 3.5, confirmed 2026-09-10) — a short,
// one-time questionnaire the Strategist/Creative Agents are grounded in
// (a "Brand voice" prompt block, app/services/strategist.py and
// creative.py) so generated strategy/ad copy stays consistent and
// on-brand across campaigns, instead of drifting variant to variant.
// One per business (businessId unique, same 1:1 shape as MetaConnection
// below) — created once via the onboarding step, editable later from the
// business page. voiceTraits is a JSON-serialized string array (kept as
// a plain String column, not a Postgres native array, so this model
// stays identical to the SQLite mirror — same "serialize at the app
// layer" convention as Strategy.content), validated as list[VoiceTrait]
// (app/schemas/brand_profile.py) on the way in and out; every other
// field here is a plain string.
model BrandProfile {
  id               String   @id @default(cuid())
  business         Business @relation(fields: [businessId], references: [id])
  businessId       String   @unique
  description      String
  idealCustomer    String
  voiceTraits      String
  brandPhrases     String?
  avoidPhrases     String?
  pricePositioning String
  tagline          String?
  competitors      String?
  exampleCopy      String?
  // Objective-aware CTA structuring (Part 1/3, confirmed 2026-09-12):
  // proofPoints feeds the Creative Agent's description slot/trust line
  // ("4.8★ from 2,100 reviews", "Free shipping over $75", ...) — a JSON
  // array, empty/null meaning none given, in which case the prompt tells
  // the model to skip that slot rather than invent one. offer is the
  // business's own standing promotion ("20% off first order with
  // WELCOME20"), distinct from Strategy.offer (a per-campaign, always-
  // present, LLM-generated field with a different meaning) — null means
  // no current promotion, and is what actually gates GET_OFFER eligibility
  // (app/schemas/creative.py's GeneratedCreativeBatch validator), not
  // Strategy.offer.
  proofPoints      String?
  offer            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Product has no separate name field — `description` ("What do you sell?")
// doubles as its identity, truncated for display in lists (PRD.md §7).
model Product {
  id          String         @id @default(cuid())
  business    Business       @relation(fields: [businessId], references: [id])
  businessId  String
  description String
  price       Float?
  margin      Float?
  features    String?
  benefits    String?
  url         String?
  images      ProductImage[]
  campaigns   Campaign[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// Image bytes live in the row itself (Option A, confirmed 2026-09-02) —
// no object storage account/credentials needed at MVP scale, and it
// survives Render's ephemeral filesystem since Postgres persists.
// Served publicly (no auth) at GET /product-images/{id} — app/api/
// product_image.py — since Meta's own servers fetch this URL directly
// for ad creative images (app/services/meta.py's link_data.picture),
// not through the browser with the user's session cookie.
model ProductImage {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  data        Bytes
  contentType String
  // User-controlled display order — the *only* source of truth for it;
  // createdAt is immutable and can't represent a reorder. Lowest first;
  // position 0 is "primary" (the photo shown as the product's thumbnail
  // and auto-attached to a creative with no image yet — see
  // app/api/creative.py's select_creative). New uploads append past the
  // current max (app/api/product_image.py), never reusing a deleted
  // photo's old position, so two photos never tie.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
}

// Same no-separate-name convention as Product — `description` ("Who buys?")
// is the identity. ageMin/ageMax are separate ints (not a freeform range
// string) to match Meta's age_min/age_max targeting fields directly.
// location/interests stay freeform text — Meta resolves those to its own
// location/interest taxonomy IDs at publish time (PRD.md §7), not here.
model Audience {
  id          String     @id @default(cuid())
  business    Business   @relation(fields: [businessId], references: [id])
  businessId  String
  description String
  ageMin      Int?
  ageMax      Int?
  location    String?
  interests   String?
  problem     String?
  desire      String?
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// adAccountId/pageId start null — a row is created once the OAuth code
// exchange succeeds (so accessToken/tokenExpiresAt/metaUserId are always
// set), but the user still has to pick which ad account and Page to use
// (one Meta identity can have several of each), via a separate finalize
// step (PRD.md build step 6, app/api/meta.py). Same "exists before it's
// complete" shape already used for Strategy before objective was known to
// be fixed, and for Creative before one variant is SELECTED.
//
// accessToken is stored encrypted (app/core/crypto.py, Fernet), not
// hashed — unlike Session/User, this token has to be usable later for
// real Marketing API calls, not just verified. Every read goes through
// app/core/meta_connection.py's get_meta_connection, which decrypts it;
// never read this column directly.
model MetaConnection {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id])
  businessId     String   @unique
  metaUserId     String
  accessToken    String
  adAccountId    String?
  pageId         String?
  // Optional — only conversion-tracking optimization goals (currently
  // just SALES -> OFFSITE_CONVERSIONS) need one. Selected as its own
  // follow-up step after adAccountId/pageId are set (GET .../meta/pixels
  // needs an ad account to query against — see app/api/meta.py), not
  // bundled into the initial finalize picker.
  pixelId        String?
  // True once the user explicitly dismissed the Pixel step for *this*
  // connection ("Skip for now" — MetaConnectionSection) rather than never
  // having gotten to it yet. Lives here, not on Business, so it resets
  // for free when the connection is dropped (disconnect deletes this row
  // outright) — a fresh connection deserves a fresh choice, not one
  // carried over from whatever was connected before (confirmed 2026-09-09,
  // replacing an earlier localStorage-only fix that got this wrong).
  pixelSkipped   Boolean  @default(false)
  tokenExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Short-lived, one-time-use CSRF state for the Meta OAuth redirect
// round-trip — id itself (an unguessable cuid) is passed as the OAuth
// `state` param. Looked up and deleted at the callback (app/api/meta.py),
// with a TTL check (see _STATE_TTL) so an old, unused row can't be replayed.
// A dedicated table rather than a signed token because the callback also
// needs to recover which business the flow was started for.
model MetaOAuthState {
  id         String   @id @default(cuid())
  businessId String
  createdAt  DateTime @default(now())
}

// Campaign.objective: SALES | LEADS | TRAFFIC | MESSAGES | AWARENESS
//                     (PRD.md §7 — maps to Meta's own campaign objectives
//                     at publish time)
// Campaign.status: see CampaignStatus (backend/app/schemas/campaign.py)
//                  for the fixed list of values — not copied here, so
//                  this comment can't drift out of sync with it again
//                  (confirmed 2026-09-09, after an earlier copy of this
//                  list here was missing READY and nearly shipped a
//                  response-serialization 500 for it).
// Campaign.name is a human-readable label (e.g. "Custom Colombian Emerald
// Ring") — without it, campaigns are only distinguishable by
// objective+product+audience, and two campaigns with the same objective
// would look identical in any list.
model Campaign {
  id                      String                       @id @default(cuid())
  business                Business                     @relation(fields: [businessId], references: [id])
  businessId              String
  product                 Product?                     @relation(fields: [productId], references: [id])
  productId               String?
  audience                Audience?                    @relation(fields: [audienceId], references: [id])
  audienceId              String?
  name                    String?
  objective               String
  status                  String                       @default("DRAFT")
  strategy                Strategy?
  adSets                  AdSet[]
  creatives               Creative[]
  metrics                 Metric[]
  optimizations           OptimizationRecommendation[]
  testEvaluations         TestEvaluation[]
  metaCampaignId          String?
  // Event/venue geo-targeting (PRD.md build step 11, confirmed
  // 2026-09-01): eventVenueKey references a curated entry in
  // app/services/event_venues.py (not a DB table — the set is small,
  // fixed, and hand-curated). startDate/endDate default from the
  // venue's typical window at campaign creation but are always
  // user-editable; both null for a non-event campaign, which still
  // runs indefinitely on its daily budget as before.
  eventVenueKey           String?
  startDate               DateTime?
  endDate                 DateTime?
  // Last time the scheduled optimization job evaluated this campaign at
  // all (app/services/optimizer.py's evaluate_all_live_campaigns) —
  // updated on every evaluation regardless of outcome (WAIT or an actual
  // recommendation), so the data-sufficiency gate's "time elapsed" leg
  // has something to measure even on runs that produce nothing.
  lastOptimizationCheckAt DateTime?
  // Set whenever a campaign is paused, by any path — a manual pause
  // (app/api/campaign.py), the scheduled end-date-elapsed job, or the
  // deterministic total-spend circuit breaker
  // (app/services/optimization_jobs.py) — so the UI can show *why* a
  // campaign stopped, not just that it did. Null for a campaign that
  // was never paused.
  pausedReason            String?
  // A live, self-clearing warning — not a pause — for a daily spend
  // sanity check (app/services/optimization_jobs.py, confirmed
  // 2026-09-03): Meta's own daily-budget pacing can overspend up to
  // ~25% on a given day (evened out across a calendar week, by Meta's
  // own documented policy), so a single day over that isn't itself
  // cause to stop the campaign — just to flag it. Refreshed every
  // collection cycle: set (or updated) while any AdSet's own last-24h
  // spend exceeds 1.25x its configured daily budget, cleared back to
  // null once none do.
  dailySpendFlag          String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
}

// content holds the full structured Marketing Strategist Agent output
// (objective/targetAudience/offer/positioning/creativeAngles/copyStrategy/
// budgetRecommendation) as a JSON-serialized string — SQLite has no native
// Json type (confirmed earlier in this build), so this follows the same
// "serialize at the app layer" pattern already used elsewhere in this
// schema, validated/typed via a Pydantic model on the way in and out.
model Strategy {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @unique
  content    String
  createdAt  DateTime @default(now())
}

// AdSet.status: DRAFT | READY | LIVE | PAUSED
model AdSet {
  id               String   @id @default(cuid())
  campaign         Campaign @relation(fields: [campaignId], references: [id])
  campaignId       String
  name             String
  budget           Float
  optimizationGoal String
  status           String   @default("DRAFT")
  ads              Ad[]
  metrics          Metric[]
  metaAdSetId      String?
  // Which TEST_PLAN AudienceVariant this AdSet is ("broad_baseline" |
  // "hypothesis_audience", app/schemas/strategy.py) — set only for a
  // TEST_PLAN campaign's two real AdSets (PRD.md build step 5 "Phase C",
  // app/services/publish.py's _publish_test_plan_variant), null for a
  // DATA_DRIVEN_STRATEGY campaign's single AdSet. Lets per-AdSet Metric
  // collection and the TEST_PLAN evaluator (step 10) map an AdSet back
  // to which variant it is without fragile name-matching.
  variantId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Ad.status: DRAFT | READY | LIVE | PAUSED
model Ad {
  id        String     @id @default(cuid())
  adSet     AdSet      @relation(fields: [adSetId], references: [id])
  adSetId   String
  name      String
  status    String     @default("DRAFT")
  creatives Creative[]
  metaAdId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Creative.status: GENERATED | SELECTED | REJECTED — one Creative per
// campaign moves to SELECTED (the rest REJECTED) when the user picks a
// variant (PRD.md build step 6/7); no per-creative APPROVED state, that
// term is reserved for the campaign-level approval gate (step 7).
// Creative.cta: a curated MVP subset of Meta's real call-to-action button
// enum (Meta has 40+ values; not replicating all of them until publish,
// step 8, actually needs to) — SHOP_NOW | LEARN_MORE | SIGN_UP | SUBSCRIBE |
// CONTACT_US | MESSAGE_PAGE | GET_OFFER | DOWNLOAD | BOOK_NOW
//
// bodyText is Meta's "Primary Text" (main copy above the image/video);
// description is Meta's separate, distinct secondary line — these are two
// different fields on Meta's own ad creative, not one.
//
// campaignId is the generation-time link — the Creative Agent runs off a
// Campaign's Strategy (build step 6), before any AdSet/Ad exists (those
// are pure publish-time constructs, step 8, needing real budget/Meta IDs
// that don't exist yet here). adId stays nullable until the selected
// Creative is actually attached to a real Ad at publish time.
//
// creativeAngle records which of the parent Strategy's creativeAngles this
// variant was built around, for traceability in the approval UI.
// imagePrompt/videoPrompt are the generation recipes, kept distinct from
// imageUrl (the resulting asset) so a variant can be regenerated/tweaked
// from its prompt.
model Creative {
  id                        String         @id @default(cuid())
  campaign                  Campaign       @relation(fields: [campaignId], references: [id])
  campaignId                String
  ad                        Ad?            @relation(fields: [adId], references: [id])
  adId                      String?
  headline                  String
  bodyText                  String
  // Nullable (confirmed 2026-09-12, Part 4 of the objective-aware CTA/
  // brand-profile structuring) — not every business has a proof point
  // that fits every variant, and the Creative Agent is told to skip this
  // slot rather than invent filler when none does.
  description               String?
  cta                       String
  creativeAngle             String?
  imagePrompt               String?
  videoPrompt               String?
  imageUrl                  String?
  // The ProductImage this creative's imageUrl was built from — a plain
  // id, not a `@relation` (deliberately, same as sourceProductId below):
  // a photo deleted after selection is handled explicitly in application
  // code (app/services/publish.py's _resolve_image_hash fails the
  // publish outright with a clear error, confirmed 2026-09-09 — a known,
  // flagged gap in ProductForm's photo-removal UI, which has no in-use
  // guard yet), not enforced as a DB-level FK cascade/restrict. Read at
  // publish time to fetch the actual image bytes for Meta's real ad
  // image upload (app/services/meta.py's upload_meta_ad_image) — imageUrl
  // alone (our own /product-images/{id} URL) isn't enough for that.
  productImageId            String?
  status                    String         @default("GENERATED")
  metaCreativeId            String?
  // Snapshot of the product this creative was generated from (PRD.md
  // "stale creative detection"). sourceProductId is nullable — a creative
  // generated with no product selected has nothing to snapshot.
  // sourceDescription/sourceUrl snapshot Product.description/.url at
  // generation time, not live references, so a later product edit or
  // swap can be detected by comparison (see app/services/creative.py's
  // is_creative_stale) without needing a join back to the product's
  // current state to know something changed.
  sourceProductId           String?
  sourceDescription         String?
  sourceUrl                 String?
  // Same snapshot idea, for the campaign's Business.description — a
  // third staleness source alongside the product fields above (confirmed
  // 2026-09-08): editing a business's own description after generating
  // creatives leaves ad copy grounded in stale business context just as
  // surely as editing the product does, so is_creative_stale checks this
  // independently of whether a product is even attached.
  sourceBusinessDescription String?
  // SINGLE_IMAGE | CAROUSEL (confirmed 2026-09-12). A carousel's cards
  // live in CreativeCard below, not as extra columns here — headline/
  // bodyText/description/cta above stay meaningful for both formats:
  // for CAROUSEL they're the shared primary text/CTA and the (unused)
  // fallback headline/description, while each card carries its own
  // headline/description. imageUrl/productImageId stay null for a
  // CAROUSEL creative — its images live on the cards instead.
  format                    String         @default("SINGLE_IMAGE")
  cards                     CreativeCard[]
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

// One card of a CAROUSEL-format Creative (Meta's child_attachments, PRD.md
// build step 6 carousel support, confirmed 2026-09-12). V1 supports only
// single-product carousels — every card of a given creative shares one
// linkUrl (the product's URL) and draws its image from the same product's
// ProductImage rows, never mixing products — so linkUrl is duplicated per
// row rather than lifted onto Creative, keeping the schema open to a
// future multi-product carousel (distinct linkUrl per card) without a
// migration.
//
// position is assigned at generation time from the order the images were
// given to the Creative Agent (ProductImage.position order, capped at
// Meta's 10-card limit) — 0-indexed, unique and contiguous per creative,
// enforced at the application layer (app/services/creative.py), not a DB
// constraint.
//
// imageUrl/productImageId mirror Creative's own pair and exist for the
// same two reasons: imageUrl (our public /product-images/{id} URL) is
// what the frontend preview renders directly; productImageId is read at
// publish time (app/services/publish.py) to fetch the actual image bytes
// for Meta's real ad image upload (app/services/meta.py's
// upload_meta_ad_image) — imageUrl alone isn't enough for that. Unlike
// Creative's image, a card's image is set at generation time, not a
// later select step (see app/services/creative.py's module docstring) —
// the Creative Agent needs every card's image up front to write
// angle-specific per-card copy against it.
model CreativeCard {
  id             String   @id @default(cuid())
  creative       Creative @relation(fields: [creativeId], references: [id])
  creativeId     String
  position       Int
  imageUrl       String
  productImageId String?
  headline       String
  description    String?
  linkUrl        String
  createdAt      DateTime @default(now())
}

// impressions/clicks/spend/conversions are the original step-9 fields —
// always present, unchanged. Everything below is the "Phase B" extended
// metric set (PRD.md §5 step 10, confirmed 2026-09-01), added for the
// TEST_PLAN Optimizer's success-criteria evaluation: all nullable, and
// null means "unavailable/not applicable to this campaign's objective,"
// never zero (same convention as NormalizedMetrics, app/schemas/
// strategy.py) — see app/services/meta.py's fetch_campaign_insights for
// exactly when each is populated vs. left null.
model Metric {
  id               String   @id @default(cuid())
  campaign         Campaign @relation(fields: [campaignId], references: [id])
  campaignId       String
  // Set only when this snapshot is one TEST_PLAN AdSet's own performance
  // (PRD.md build step 10, per-AdSet metric collection, confirmed
  // 2026-09-02) — null for the pre-existing campaign-level aggregate
  // collection (DATA_DRIVEN_STRATEGY's single AdSet, and any TEST_PLAN
  // history collected before this field existed). Lets the TEST_PLAN
  // evaluator compare each variant's own real numbers instead of one
  // undifferentiated pool.
  adSet            AdSet?   @relation(fields: [adSetId], references: [id])
  adSetId          String?
  impressions      Int
  clicks           Int
  spend            Float
  conversions      Int
  reach            Int?
  cpm              Float?
  ctr              Float?
  cpc              Float?
  landingPageViews Int?
  addToCart        Int?
  addToCartRate    Float?
  conversionRate   Float?
  cac              Float?
  purchaseValue    Float?
  roas             Float?
  // Purchase-specific count, distinct from the broader `conversions`
  // sum — `cac` above is a lifetime-to-date ratio, not something a
  // rolling window can delta directly, so the raw count is stored too
  // (spend delta / purchases delta between two snapshots gives a real
  // rolling-window CAC — app/services/optimization_jobs.py's CAC
  // circuit breaker, confirmed 2026-09-03).
  purchases        Int?
  fetchedAt        DateTime @default(now())
}

// OptimizationRecommendation.actionType: PAUSE_AD | INCREASE_BUDGET |
//                                        DECREASE_BUDGET
// OptimizationRecommendation.status: PENDING | APPLIED | REJECTED | SUPERSEDED
// — no separate APPROVED state: approving IS applying, one explicit click
// (PRD.md build step 10's checkpoint), same "approve = act" shape as
// Campaign's own PENDING_APPROVAL -> APPROVED -> LIVE, just collapsed to
// one step here since there's nothing further to gate after approval.
// Generating a new recommendation moves any still-PENDING one for the
// same campaign to SUPERSEDED rather than deleting it, so the decision
// history (including recommendations nobody acted on) stays queryable —
// unlike Strategy/Creative, past recommendations are meaningful history,
// not stale drafts.
//
// targetAdId records which local Ad a PAUSE_AD recommendation targets
// (the campaign's only Ad today, since publish creates exactly one — see
// app/services/publish.py — but the field models Meta's real shape:
// per-ad pausing, not per-campaign). currentBudget/suggestedBudget are
// only meaningful for INCREASE_BUDGET/DECREASE_BUDGET; suggestedBudget is
// already guardrail-capped (see app/services/optimizer.py) by the time
// it's stored, not the LLM's raw, unbounded suggestion.
//
// OptimizationRecommendation.risk: LOW | MEDIUM | HIGH — the LLM's own
// self-assessment, part of its forced tool call (confidence too).
// requiresApproval is deliberately NOT taken from the LLM — it's computed
// by app/services/optimizer.py's compute_requires_approval from
// risk/confidence/guardrails, so a future auto-apply capability is a rule
// change there, not a schema or LLM-trust change. Always true today
// (PRD.md build step 10's checkpoint requirement — every recommendation
// requires a human click, regardless of computed risk, until auto-apply
// for LOW risk is explicitly built).
model OptimizationRecommendation {
  id               String   @id @default(cuid())
  campaign         Campaign @relation(fields: [campaignId], references: [id])
  campaignId       String
  actionType       String
  targetAdId       String?
  currentBudget    Float?
  suggestedBudget  Float?
  reasoning        String
  confidence       Float
  risk             String
  requiresApproval Boolean  @default(true)
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// TestEvaluation is the Optimizer's read on a TEST_PLAN campaign (PRD.md
// §5 step 10 "Phase B", confirmed 2026-09-01) — compares real Metric
// history against the original Strategy.content (the persisted test
// plan), answering "did the campaign accomplish what the test set out to
// test?" A new row each time it's (re-)generated, same "history stays
// queryable, not overwritten" reasoning as OptimizationRecommendation.
//
// TestEvaluation.status: SUFFICIENT_DATA | INSUFFICIENT_DATA — the
// backend's own gate (has_sufficient_test_data, app/services/
// optimizer.py), tied to the test's own declared totalBudget/
// durationDays, not a fixed constant; never the LLM's call.
//
// TestEvaluation.hypothesisResult: SUPPORTED | REJECTED | INCONCLUSIVE —
// always INCONCLUSIVE today. Real two-variant publishing ("Phase C")
// doesn't exist yet (campaign publish still creates exactly one AdSet,
// app/services/publish.py), so there's no real data for the
// hypothesis-driven variant to compare the published broad-baseline
// variant against. Kept as its own field (not inferred from
// winningVariant) so this isn't a breaking change once Phase C lands.
//
// TestEvaluation.winningVariant is nullable and, for the same reason,
// always null today.
//
// TestEvaluation.confidence: LOW | MEDIUM | HIGH — the LLM's own
// self-assessment, part of its forced tool call, same pattern as
// OptimizationRecommendation.risk.
//
// TestEvaluation.recommendedAction is one of the TEST_PLAN's own
// decision_rules actions (app/schemas/strategy.py's
// TEST_PLAN_DECISION_RULES) — excluding prefer_broad/prefer_hypothesis,
// which require the cross-variant comparison Phase C would enable.
//
// keyFindings is JSON-serialized (list[str]) — SQLite has no native
// array/Json type, same pattern as Strategy.content.
model TestEvaluation {
  id                String   @id @default(cuid())
  campaign          Campaign @relation(fields: [campaignId], references: [id])
  campaignId        String
  status            String
  winningVariant    String?
  confidence        String
  hypothesisResult  String
  keyFindings       String
  recommendedAction String
  reasoning         String
  stopReason        String   @default("MANUAL")
  createdAt         DateTime @default(now())
}
